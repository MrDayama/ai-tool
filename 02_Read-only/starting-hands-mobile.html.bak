 "score": 30, "notes": "weak connectors"}, {"tier": "C", "ranks": "3 4 5 9 T", "hand": "3♣ 4♣ 5♣ 9♣ T♦", "score": 30, "notes": "weak connectors"}, {"tier": "C", "ranks": "3 4 5 9 T", "hand": "3♣ 4♣ 5♣ 9♣ T♣", "score": 30, "notes": "weak connectors"}]</script>
<script>
const raw = document.getElementById('data').textContent;
const items = JSON.parse(raw);
let filtered = items.slice();
const body = document.getElementById('body');
const q = document.getElementById('q');
const tier = document.getElementById('tier');
const sort = document.getElementById('sort');
const apply = document.getElementById('apply');
const prev = document.getElementById('prev');
const next = document.getElementById('next');
const pageinfo = document.getElementById('pageinfo');
const pagesizeSel = document.getElementById('pagesize');
let page = 1;
function render(){
  const ps = parseInt(pagesizeSel.value,10);
  const start = (page-1)*ps;
  const end = start+ps;
  body.innerHTML = '';
  const slice = filtered.slice(start,end);
  for(const it of slice){
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${it.tier}</td><td>${it.hand}</td><td>${it.score}</td><td>${it.notes||''}</td>`;
    body.appendChild(tr);
  }
  pageinfo.textContent = `ページ ${page} / ${Math.max(1,Math.ceil(filtered.length/ps))} — 結果 ${filtered.length} 件`;
}
function applyFilter(){
  const qq = q.value.trim();
  const tt = tier.value;
  const st = sort.value;
  filtered = items.filter(it=>{
    if(tt && it.tier!==tt) return false;
    if(!qq) return true;
    const L = (it.hand+' '+(it.notes||'')).toLowerCase();
    return L.indexOf(qq.toLowerCase())!==-1 || it.tier.toLowerCase()===qq.toLowerCase();
  });
  if(st==='-score') filtered.sort((a,b)=>b.score-a.score);
  else if(st==='score') filtered.sort((a,b)=>a.score-b.score);
  else if(st==='hand') filtered.sort((a,b)=>a.hand.localeCompare(b.hand));
  page = 1;
  render();
}
apply.addEventListener('click',applyFilter);
pagesizeSel.addEventListener('change',()=>{page=1;render();});
prev.addEventListener('click',()=>{if(page>1){page--;render();}});
next.addEventListener('click',()=>{const ps = parseInt(pagesizeSel.value,10); if(page*ps<filtered.length){page++;render();}});
// initial
applyFilter();
</script>
</body>
</html>